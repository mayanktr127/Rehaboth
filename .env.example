# Rehaboth Mobile & Universal App Environment Configuration
# Copy to .env or .env.local to configure

# Base URL for the production or staging API (leave empty or unset to use the built-in Mock Adapter)
# Example for local backend: http://localhost:8090
# Example for Android emulator loopback: http://10.0.2.2:8090
# Example for remote staging: https://api-staging.rehaboth.com
EXPO_PUBLIC_API_BASE_URL=
